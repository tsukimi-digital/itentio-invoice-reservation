# Copy to .env before running locally: cp .env.example .env

# --- HTTP ---
PORT=3000
NODE_ENV=development

# --- Database ---
# Matches the credentials in docker-compose.yml
DATABASE_URL=postgresql://itentio:itentio@localhost:5432/itentio?schema=public

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=itentio-invoice-reservation
KAFKA_GROUP_ID=itentio-capacity-consumer
# Silences a cosmetic kafkajs v2 warning about its default partitioner change.
KAFKAJS_NO_PARTITIONER_WARNING=1

# --- FX ---
# Currency used to derive a cross rate when neither a direct nor an inverse
# rate exists. Validated at boot, unlike before, when it was read straight
# from process.env and a typo failed at request time instead.
FX_PIVOT_CURRENCY=USD
# Reject any rate older than this. The 7-day default suits a locally seeded
# database; a deployment with a live feed should use single-digit hours.
FX_MAX_RATE_AGE_HOURS=168

# --- HTTP / proxying ---
# Proxy hops to trust when resolving the client IP. 0 = trust nothing (correct
# for a directly-exposed process). Behind one load balancer set this to 1 —
# rate limiting is only as sound as this value.
TRUST_PROXY_HOPS=0

# --- Auth ---
# Dev-only secret. Env validation REFUSES this exact value (and anything under
# 32 characters) when NODE_ENV=production, so copying this file to a real
# deployment fails at boot rather than signing tokens with a key that is
# published in this repository.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_TTL_DAYS=30

# Optional: seeds an admin with this password instead of the dev default.
# Required to seed any admin at all when NODE_ENV=production.
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_EMAIL=
