# Copy to .env before running locally: cp .env.example .env

# --- HTTP ---
PORT=3000
NODE_ENV=development

# --- Database ---
# Matches the credentials in docker-compose.yml
DATABASE_URL=postgresql://itentio:itentio@localhost:5432/itentio?schema=public

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=itentio-invoice-reservation
KAFKA_GROUP_ID=itentio-capacity-consumer
# Silences a cosmetic kafkajs v2 warning about its default partitioner change.
KAFKAJS_NO_PARTITIONER_WARNING=1

# --- Auth ---
# Dev-only secret. Replace with a managed secret in any real deployment.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_TTL_DAYS=30
